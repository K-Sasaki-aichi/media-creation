ааа ЫЫЫ ббб ннн еее ооо ▓▓▓ ╣╣╣ ╣╣╣ ╡╡╡ ХХХ ЮЮЮ ккк ╡╡╡ иии ддд ЪЪЪ еее ввв ддд ЩЩЩ ббб ддд ааа иии ллл ллл ллл ппп ╣╣╣ ╕╕╕ ╣╣╣ ░░░ ллл ааа иии ззз ййй ннн ░░░ ░░░ ооо ннн ннн ╕╕╕ жжж еее ггг ззз ооо ШШШ ввв ззз ЮЮЮ ааа ЩЩЩ ййй ббб ббб ккк ззз ммм ааа ййй ЯЯЯ ггг ззз ббб ннн ммм ▓▓▓ ╝╝╝ ╜╜╜ ┴┴┴ ┴┴┴ ╜╜╜ ╗╗╗ ╣╣╣ ╖╖╖ ╜╜╜ ╕╕╕ ╗╗╗ ╣╣╣ ╣╣╣ ╗╗╗ ╝╝╝ ║║║ ║║║ ЮЮЮ ггг ЭЭЭ ддд ллл ммм ммм ммм ппп ооо ммм ммм ззз ййй ззз ЯЯЯ жжж жжж ЭЭЭ ШШШ ЯЯЯ ккк ЯЯЯ ╢╢╢ ппп еее ╖╖╖ ооо ЧЧЧ ггг ммм ╕╕╕ ╣╣╣ │││ ЯЯЯ ггг ггг иии ЩЩЩ ЪЪЪ ааа ЮЮЮ ггг ннн ззз еее ввв ааа ооо ммм ббб ккк жжж ммм ╕╕╕ ╕╕╕ ╣╣╣ ммм ммм ммм ккк ллл ┤┤┤ ййй ааа ааа ккк ╢╢╢ ддд ЩЩЩ ллл ааа ааа ЬЬЬ ЯЯЯ ппп ╖╖╖ ╕╕╕ ккк жжж ЯЯЯ ббб жжж ЭЭЭ ввв жжж иии ййй ллл ╢╢╢ ├├├ ╖╖╖ ╟╟╟ ┬┬┬ ╛╛╛ ║║║ ┤┤┤ ╡╡╡ ╣╣╣ ╜╜╜ еее ввв ввв ггг ккк ааа УУУ ааа ааа ааа ┤┤┤ ╜╜╜ ╖╖╖ ║║║ ╕╕╕ ╕╕╕ ╗╗╗ ║║║ ║║║ ║║║ ▒▒▒ ШШШ ░░░ ЯЯЯ ЫЫЫ ЧЧЧ ЮЮЮ ллл ггг ккк ┤┤┤ ввв иии │││ ШШШ ЩЩЩ ггг ппп ║║║ ннн ммм ллл ╕╕╕ ╖╖╖ ░░░ ЫЫЫ ЬЬЬ ггг ддд ббб ннн ллл ммм ллл жжж ┤┤┤ жжж ааа ккк ййй ддд ккк ллл ззз ллл ооо ▒▒▒ ▓▓▓ ппп ┤┤┤ ооо ззз ддд иии ╡╡╡ ййй ЪЪЪ ззз ддд ззз ЩЩЩ ккк ззз еее ооо ллл ╕╕╕ ╕╕╕ ║║║ ппп ЭЭЭ ббб еее ддд ййй ▓▓▓ ╡╡╡ ╣╣╣ ┐┐┐ ─── └└└ ╞╞╞ ╣╣╣ │││ ╡╡╡ ╕╕╕ ╝╝╝ ггг ЬЬЬ жжж еее ппп иии ЪЪЪ ЯЯЯ ЮЮЮ ЪЪЪ ддд ккк иии иии ллл ооо ннн иии жжж ▒▒▒ ннн ШШШ ддд ззз ЫЫЫ ФФФ ЩЩЩ ммм ззз ЪЪЪ ллл ввв ммм ЯЯЯ ггг ннн ааа ЮЮЮ ЧЧЧ ддд ннн ммм иии иии ммм ммм ммм ммм ннн ▒▒▒ ░░░ ╖╖╖ ║║║ ╝╝╝ ┤┤┤ ШШШ ЧЧЧ иии ШШШ ЪЪЪ ЩЩЩ ааа ммм ддд ддд ййй ггг ббб ЫЫЫ ЫЫЫ ССС ггг ккк жжж ЧЧЧ ЫЫЫ ▒▒▒ ▓▓▓ │││ ╕╕╕ ╝╝╝ ╕╕╕ ккк ллл жжж ййй ░░░ ▒▒▒ ммм ййй ллл ┤┤┤ ╛╛╛ ╝╝╝ ╗╗╗ ╜╜╜ ║║║ ззз иии ййй ззз ппп ппп иии ▒▒▒ ккк ккк ппп ааа жжж ЯЯЯ ЦЦЦ ССС ЯЯЯ еее ЫЫЫ ЮЮЮ ппп ййй ммм ╡╡╡ ▓▓▓ ммм ззз ╣╣╣ ннн ннн ░░░ ▒▒▒ ззз еее ЯЯЯ ЪЪЪ ШШШ ЬЬЬ еее ллл ооо ╡╡╡ ║║║ ▓▓▓ ккк ЦЦЦ ЪЪЪ ЯЯЯ ммм ▓▓▓ ▒▒▒ иии иии ммм ░░░ ▒▒▒ ннн ллл ║║║ иии ммм ййй ббб ннн УУУ жжж ╣╣╣ ╣╣╣ ннн ЩЩЩ ддд ддд ЭЭЭ ооо иии ггг ззз ддд ЯЯЯ ЪЪЪ ЪЪЪ жжж ЩЩЩ ЧЧЧ ввв ннн ▓▓▓ ппп ▒▒▒ ╕╕╕ ооо ййй ммм ммм ййй ╖╖╖ ооо ннн ннн ннн ▓▓▓ ббб ЩЩЩ ааа ШШШ ШШШ жжж ззз ккк ╣╣╣ ╗╗╗ иии ммм ллл ллл ооо ооо ЭЭЭ ммм ЬЬЬ ЦЦЦ ТТТ ЪЪЪ ззз ббб иии ╡╡╡ ╣╣╣ ╕╕╕ ╝╝╝ ▓▓▓ ннн ллл ╖╖╖ ппп ллл ммм ллл ййй еее ЭЭЭ ШШШ ЧЧЧ ЩЩЩ ггг иии ббб жжж ооо ║║║ ╗╗╗ ╣╣╣ ккк ЭЭЭ ддд ккк ооо еее ддд ллл ооо ооо ооо ооо ┤┤┤ ооо иии еее ммм ооо ФФФ ббб ддд ЬЬЬ ЩЩЩ ввв ззз ззз ззз ззз ккк ггг ЯЯЯ ддд ЮЮЮ ШШШ ддд ааа ЯЯЯ ЯЯЯ еее ммм ллл ззз ╡╡╡ ╣╣╣ ннн ддд ╕╕╕ ╜╜╜ ╣╣╣ ╝╝╝ ╣╣╣ ║║║ ╝╝╝ ╣╣╣ ╗╗╗ ║║║ ЮЮЮ ббб ЧЧЧ ЩЩЩ ддд иии ллл ллл │││ ппп ггг ллл жжж ░░░ еее ддд жжж ЩЩЩ УУУ ЦЦЦ ЬЬЬ иии ЩЩЩ иии ннн ббб ммм ░░░ ппп иии ддд ╢╢╢ ╣╣╣ ┤┤┤ ммм ннн ммм ййй ггг ЬЬЬ ааа ЮЮЮ ааа ггг иии жжж ввв ббб ллл ааа ббб ЪЪЪ ддд ппп ╝╝╝ ╗╗╗ ╝╝╝ ллл ооо ▒▒▒ ░░░ ззз ╖╖╖ ккк ййй ззз ббб ппп ЯЯЯ ааа ккк ЪЪЪ ЩЩЩ ЩЩЩ ддд ┤┤┤ ╣╣╣ ╣╣╣ ййй ЯЯЯ ввв еее ггг ЪЪЪ ЧЧЧ ллл ввв ЪЪЪ ббб ллл ░░░ ннн ╡╡╡ ┐┐┐ ╢╢╢ ▒▒▒ ддд ззз ззз ╕╕╕ ооо ппп ппп ннн ппп ввв ЪЪЪ ЭЭЭ ЫЫЫ ЫЫЫ ╝╝╝ └└└ ║║║ ┐┐┐ ║║║ ╝╝╝ ╗╗╗ ║║║ ║║║ ╗╗╗ ммм ааа ззз ЮЮЮ ХХХ ТТТ ЪЪЪ ззз ЮЮЮ ЯЯЯ ╡╡╡ еее жжж ▓▓▓ ▓▓▓ еее ддд │││ └└└ ллл ййй ┤┤┤ ╗╗╗ ║║║ ▒▒▒ еее ггг ааа ЭЭЭ ЯЯЯ ллл ккк ннн жжж ааа ▓▓▓ еее ЬЬЬ ЬЬЬ еее ннн ллл ззз ддд ккк ннн ▒▒▒ │││ ллл ▓▓▓ ▓▓▓ ллл еее ггг ппп ввв ЧЧЧ еее ааа ббб ЧЧЧ ввв жжж ддд иии ммм ╝╝╝ ║║║ ╗╗╗ ооо ХХХ ЪЪЪ ккк ааа ЮЮЮ ааа ммм ооо ▒▒▒ ппп │││ │││ ооо ззз жжж ккк ╡╡╡ ооо ннн ппп ммм ╕╕╕ жжж ШШШ ЮЮЮ ЮЮЮ ЩЩЩ ЮЮЮ ггг еее жжж ззз ппп ггг ввв ллл иии ооо ббб жжж ввв ЧЧЧ ХХХ ЦЦЦ ййй ЮЮЮ ддд ггг ззз ппп ааа ййй ▒▒▒ ЯЯЯ ЦЦЦ УУУ еее ккк ззз ггг иии ┤┤┤ ▓▓▓ ▓▓▓ ▓▓▓ ▓▓▓ │││ ▓▓▓ ╖╖╖ ║║║ ╜╜╜ ┤┤┤ ЪЪЪ ШШШ иии ЩЩЩ ШШШ ТТТ ббб ккк ввв еее ггг ббб ггг ббб ааа ЬЬЬ еее ллл ййй ЬЬЬ ааа ▒▒▒ ╡╡╡ ╕╕╕ ┴┴┴ ╟╟╟ ╡╡╡ жжж ззз ббб ЯЯЯ ккк ░░░ ооо ккк ллл ┤┤┤ ╛╛╛ ╝╝╝ ╗╗╗ ╜╜╜ ╗╗╗ ▓▓▓ ммм ддд ЬЬЬ ппп ▒▒▒ жжж ллл ░░░ ннн ммм ЩЩЩ ааа ЪЪЪ ФФФ ТТТ ааа еее ЪЪЪ ЬЬЬ ппп ййй жжж иии ййй ккк ккк ╗╗╗ ккк ллл ооо ░░░ ┤┤┤ ннн ааа ЦЦЦ ЦЦЦ ддд ккк ггг ййй ╖╖╖ ╜╜╜ ╣╣╣ │││ ЫЫЫ ХХХ РРР жжж ккк ккк еее жжж ннн ┤┤┤ ╖╖╖ ннн ййй ┤┤┤ иии ккк ггг ЮЮЮ ▒▒▒ ЦЦЦ ллл ╗╗╗ ╝╝╝ ммм УУУ еее ййй еее ккк ЮЮЮ ЯЯЯ ббб ддд ааа ЧЧЧ ааа ллл жжж ббб ггг ░░░ ║║║ ╗╗╗ ┼┼┼ ┼┼┼ ннн ааа ввв ггг ЯЯЯ ооо ммм ллл ллл ммм ╖╖╖ ззз ааа ззз ЯЯЯ ЮЮЮ ннн ммм ййй ╖╖╖ ╝╝╝ ннн ллл ллл ййй жжж жжж ШШШ ввв ЦЦЦ ФФФ ФФФ ЩЩЩ ббб ЭЭЭ ззз ╡╡╡ ╝╝╝ ╗╗╗ ╗╗╗ ооо ммм ▒▒▒ ╢╢╢ ййй жжж ккк │││ ╢╢╢ ▒▒▒ иии ЪЪЪ УУУ ШШШ ааа ЯЯЯ ммм ллл ппп ╜╜╜ ╕╕╕ ╗╗╗ ззз ЧЧЧ ззз ннн ммм ззз жжж ккк ппп ппп ппп ппп ооо ййй еее ггг еее ммм ЧЧЧ еее жжж ЪЪЪ ЧЧЧ ХХХ еее ввв ввв жжж ааа ЯЯЯ ввв жжж ЫЫЫ ЬЬЬ ййй ооо иии ЮЮЮ ггг ▓▓▓ ╖╖╖ ║║║ ╟╟╟ ┴┴┴ ззз ЭЭЭ ╛╛╛ ╛╛╛ ╗╗╗ ╛╛╛ ╝╝╝ ╝╝╝ ╜╜╜ ╖╖╖ ╣╣╣ ╗╗╗ ЮЮЮ еее ааа жжж ллл ллл иии ддд ллл ппп ккк │││ ннн ллл ааа ЭЭЭ жжж ЫЫЫ ТТТ РРР ШШШ ггг ЮЮЮ ммм │││ иии ннн ккк ззз ззз жжж ╣╣╣ ╝╝╝ │││ ллл ░░░ │││ ппп жжж ЭЭЭ ППП ЯЯЯ ккк ййй иии ░░░ ЯЯЯ ззз ппп ШШШ ФФФ УУУ ввв ллл ╝╝╝ ╗╗╗ ╜╜╜ ммм ░░░ │││ │││ ннн ╖╖╖ ппп ккк ггг ЮЮЮ ▓▓▓ ввв ЮЮЮ иии ЬЬЬ ЦЦЦ ШШШ еее ┤┤┤ ║║║ ║║║ иии ЮЮЮ ввв ввв ЯЯЯ ЫЫЫ ЯЯЯ ннн ййй ввв ааа ннн ╢╢╢ ╕╕╕ ╞╞╞ ╔╔╔ ┤┤┤ ззз ЯЯЯ ббб ЮЮЮ ппп ооо ммм ммм ооо ╡╡╡ иии ббб ддд ддд ббб ╝╝╝ └└└ ║║║ ┐┐┐ ║║║ ╝╝╝ ╜╜╜ ╕╕╕ ╕╕╕ ╝╝╝ ййй ЧЧЧ еее ЦЦЦ ФФФ ФФФ ЩЩЩ ббб ШШШ ддд ╕╕╕ ййй жжж жжж жжж жжж ввв ░░░ ╖╖╖ ййй ппп ╢╢╢ ╗╗╗ ╝╝╝ ║║║ ннн ЯЯЯ ЦЦЦ ааа иии ввв жжж │││ ззз ооо ▒▒▒ ЬЬЬ ЧЧЧ ЧЧЧ ЬЬЬ ккк ййй иии ззз ппп ░░░ ▓▓▓ │││ ▒▒▒ ║║║ ╡╡╡ ддд иии ааа ззз ззз ааа иии ЩЩЩ ТТТ ХХХ ЮЮЮ ккк жжж ггг ййй ╗╗╗ ╗╗╗ ╝╝╝ ооо ЫЫЫ ЯЯЯ иии ззз ааа ввв ппп ╕╕╕ ║║║ └└└ ╔╔╔ ╖╖╖ еее ЮЮЮ ЭЭЭ ааа ▓▓▓ │││ ммм ооо ккк ╖╖╖ ллл ЭЭЭ ддд ддд ггг жжж еее ггг ааа ззз ╢╢╢ ▒▒▒ ллл ллл ааа жжж ХХХ ЯЯЯ ааа ХХХ ООО ШШШ ббб ааа │││ ▒▒▒ │││ ║║║ ║║║ ╖╖╖ ╢╢╢ ддд ллл еее ллл ввв ддд еее ллл ▓▓▓ ▒▒▒ ▒▒▒ ▒▒▒ ▒▒▒ ╣╣╣ ▓▓▓ ╢╢╢ ╗╗╗ ╜╜╜ ╖╖╖ ббб ХХХ еее ЮЮЮ ббб ЧЧЧ ЮЮЮ ввв ЪЪЪ ввв ггг ббб ггг ббб ЯЯЯ ддд ггг жжж ййй ааа ввв ооо │││ ╡╡╡ ║║║ ╛╛╛ ┤┤┤ еее ззз ббб ззз ннн ммм еее ййй ллл ┤┤┤ ╛╛╛ ╝╝╝ ╗╗╗ ╜╜╜ ║║║ иии ййй иии еее ккк ооо ЯЯЯ ЪЪЪ ЬЬЬ еее ┤┤┤ ооо ллл ййй ззз иии ззз ппп ллл ▒▒▒ ┤┤┤ │││ ▒▒▒ ооо ооо │││ ▓▓▓ ╜╜╜ ооо ппп ▓▓▓ ┤┤┤ ░░░ ▒▒▒ ▒▒▒ ппп ккк ░░░ │││ ппп ╢╢╢ ╛╛╛ ╖╖╖ └└└ ▓▓▓ жжж иии ггг еее ддд еее жжж иии ммм ░░░ ▒▒▒ ▓▓▓ ппп ▓▓▓ ░░░ ддд ддд ббб ▓▓▓ ЪЪЪ иии ╣╣╣ ║║║ ▓▓▓ ЫЫЫ ввв ЬЬЬ ааа жжж ЬЬЬ ЮЮЮ жжж ггг ааа ЮЮЮ ззз ййй иии ЪЪЪ 